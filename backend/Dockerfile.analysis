FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g typescript jest

RUN pip install --no-cache-dir ruff bandit mypy pytest coverage

WORKDIR /analysis
COPY app/core/linting.py app/core/security_scan.py app/core/run_analysis.py app/core/type_check.py app/core/dependency_diff.py app/core/diff_stats.py app/core/test_mapping.py app/core/test_runner.py app/core/risk_score.py ./

# non-root: even inside the sandbox, don't run as root
RUN useradd -m runner
USER runner

ENTRYPOINT ["python", "run_analysis.py"]